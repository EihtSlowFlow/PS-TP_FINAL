#--------------------------------------------------------------------
# InmoGestión 2026 - local environment template
#
# Copy this file to .env and fill in your own values. The real .env is
# ignored by git: never commit it and never put real credentials here.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE (InnoDB, utf8mb4). Tested on MySQL 8.4 and MariaDB 11.4.
# CHECK constraints are only enforced from MySQL 8.0.16 (older versions ignore them).
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = inmogestion2026
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# A separate, disposable database used only by PHPUnit. It must NOT be the
# same as the one above: the tests roll back and recreate every table.
database.tests.hostname = localhost
database.tests.database = inmogestion2026_test
database.tests.username =
database.tests.password =
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SEEDERS
# Read by `php spark db:seed DatabaseSeeder` (administrator) and by
# `php spark db:seed DemoSeeder` (demo users). Choose passwords of at
# least 8 characters; they are stored hashed with BCRYPT.
#--------------------------------------------------------------------
seed.adminEmail =
seed.adminPassword =
# Optional, with defaults: Admin / InmoGestion / 00000000
# seed.adminFirstName =
# seed.adminLastName =
# seed.adminDocument =
seed.demoPassword =
